  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "start": "node backend/server.mjs",
    "app": "electron .",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:ui": "node --experimental-strip-types --test tests/ui/*.test.mjs",
